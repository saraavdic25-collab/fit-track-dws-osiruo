# ============================================
# FIT TRACER - Environment Variables Template
# ============================================
# Kopiraj ovaj fajl u .env i popuni sa svojim vrijednostima
# cp .env.example .env

# Backend konfiguracija
BACKEND_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Frontend konfiguracija
FRONTEND_PORT=80
REACT_APP_API_URL=http://localhost:3000
REACT_APP_ENVIRONMENT=production

# Database
DB_PATH=./db.json

# GCP konfiguracija (za Cloud Run deployment)
GCP_PROJECT_ID=your-project-id
GCP_REGION=europe-west1
GCP_SERVICE_NAME=fit-tracer-backend
GCP_ARTIFACT_REPO=fit-tracer-repo

# Docker konfiguracija
DOCKER_REGISTRY=gcr.io
DOCKER_IMAGE_TAG=latest

# Sigurnost
JWT_SECRET=your-super-secret-key-change-this
CORS_ORIGIN=http://localhost:80

# Monitoring
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Cloud Run specifična
CPU=1
MEMORY=512Mi
MAX_INSTANCES=100
MIN_INSTANCES=1
